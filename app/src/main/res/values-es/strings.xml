    <string name="about_feat_gemini_desc">Conversaciones de voz en tiempo real, con interrupciones naturales y correcciones útiles.</string>
    <string name="about_feat_auto_title">Compatible con Android Auto</string>
    <string name="about_feat_auto_desc">Control manos libres con los botones del volante y comandos de voz para conducir con total seguridad.</string>
    <string name="about_feat_azure_title">Puntuación de pronunciación en varias capas</string>
    <string name="about_feat_azure_desc">Combina Gemini con Microsoft Azure Speech Assessment, hasta la precisión de cada sonido.</string>
    <string name="about_feat_privacy_title">Privacidad total de tus datos</string>
    <string name="about_feat_privacy_desc">Sin registro ni anuncios; todo tu historial de práctica se guarda en tu dispositivo.</string>
    <string name="about_no_email_app">No se encontró ninguna app de correo</string>
    <string name="privacy_title">Política de privacidad</string>
    <string name="privacy_voice_title">Voz y audio</string>
    <string name="privacy_voice_desc">El audio del micrófono se envía directamente a Google Gemini Live durante la lección. SpeakDrive no guarda ni graba archivos de audio.</string>
    <string name="privacy_data_title">Datos de las conversaciones</string>
    <string name="privacy_data_desc">Las transcripciones, puntuaciones, correcciones y el vocabulario se guardan en tu dispositivo. La transcripción se envía una vez a Gemini al terminar la lección para crear el resumen. La app no tiene servidor propio y no vende datos.</string>
    <string name="privacy_third_party_title">Servicios de terceros</string>
    <string name="privacy_third_party_desc">Firebase (Google) gestiona las solicitudes a la IA y usa App Check para evitar abusos. Consulta la política de Google en policies.google.com/privacy. Microsoft Azure Speech solo se usa si activas la puntuación de Azure con tu propia clave.</string>
    <string name="privacy_rights_title">Tus derechos</string>
    <string name="privacy_rights_desc">Puedes borrar todos los datos de aprendizaje cuando quieras con el botón de abajo o desinstalando la app.</string>
    <string name="privacy_driving_title">Seguridad al conducir</string>
    <string name="privacy_driving_desc">SpeakDrive está pensado para usarse por voz y manos libres. La seguridad vial es siempre lo primero; no manipules el móvil mientras conduces.</string>
    <string name="privacy_btn_delete_all">Borrar todos los datos de aprendizaje</string>
