<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup for Android 11 and lower (Android 12+ uses data_extraction_rules.xml).
   The learning history (Room database) is backed up. Preferences are not: they can hold the
   learner's own Azure key, and the App Check debug token must stay unique to each install.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
