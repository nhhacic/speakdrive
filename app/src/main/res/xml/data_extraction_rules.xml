<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup and device-to-device transfer. The learning history (Room database) is kept.
   Preferences are not copied: they can hold the learner's own Azure key, and the App Check debug
   token must stay unique to each install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
