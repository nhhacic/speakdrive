    <string name="about_feat_gemini_title">Tuteur IA Gemini Live</string>
    <string name="about_feat_gemini_desc">Conversations vocales en temps réel, avec interruptions naturelles et corrections utiles.</string>
    <string name="about_feat_auto_title">Compatible Android Auto</string>
    <string name="about_feat_auto_desc">Commande mains libres par les boutons du volant et la voix, pour une conduite en toute sécurité.</string>
    <string name="about_feat_azure_title">Notation de la prononciation sur plusieurs niveaux</string>
    <string name="about_feat_azure_desc">Combine Gemini et Microsoft Azure Speech Assessment, jusqu\'à la précision de chaque son.</string>
    <string name="about_feat_privacy_title">Confidentialité totale des données</string>
    <string name="about_feat_privacy_desc">Pas de compte, pas de publicité, et tout l\'historique reste sur ton appareil.</string>
    <string name="about_no_email_app">Aucune app de messagerie trouvée</string>
    <string name="privacy_title">Politique de confidentialité</string>
    <string name="privacy_voice_title">Voix et audio</string>
    <string name="privacy_voice_desc">Le son du micro est envoyé directement à Google Gemini Live pendant la leçon. SpeakDrive n\'enregistre aucun fichier audio.</string>
    <string name="privacy_data_title">Données des conversations</string>
    <string name="privacy_data_desc">Les transcriptions, scores, corrections et le vocabulaire sont stockés sur ton appareil. La transcription est envoyée une fois à Gemini à la fin de la leçon pour créer le résumé. L\'app n\'a pas de serveur propre et ne vend pas de données.</string>
    <string name="privacy_third_party_title">Services tiers</string>
    <string name="privacy_third_party_desc">Firebase (Google) traite les requêtes à l\'IA et utilise App Check contre les abus. Voir la politique de Google sur policies.google.com/privacy. Microsoft Azure Speech n\'est utilisé que si tu actives la notation Azure avec ta propre clé.</string>
    <string name="privacy_rights_title">Tes droits</string>
    <string name="privacy_rights_desc">Tu peux supprimer toutes tes données d\'apprentissage à tout moment avec le bouton ci-dessous ou en désinstallant l\'app.</string>
    <string name="privacy_driving_title">Sécurité au volant</string>
    <string name="privacy_driving_desc">SpeakDrive est conçu pour une utilisation vocale mains libres. La sécurité routière passe toujours en premier ; ne manipule pas ton téléphone en conduisant.</string>
    <string name="privacy_btn_delete_all">Supprimer toutes les données</string>
    <string name="privacy_deleted_success">Toutes les données d\'apprentissage ont été supprimées.</string>
    <string name="privacy_confirm_dialog_title">Confirmer la suppression</string>
    <string name="privacy_confirm_dialog_desc">Veux-tu vraiment supprimer tout l\'historique, le vocabulaire et les statistiques ? Cette action est irréversible.</string>
